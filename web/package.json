{
  "name": "openlove-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "arch-test": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "contracts": "node scripts/contracts.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.6.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.34.7"
